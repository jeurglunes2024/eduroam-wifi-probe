{
  "uid": "eduroam-rf",
  "title": "eduroam RF Survey",
  "description": "Everything the probe can hear at a location.",
  "tags": [
    "eduroam"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "eduroam"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "eduroam dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "location",
        "label": "Location",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "eduroam-influx"
        },
        "hide": 0,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"eduroam\", tag: \"location\", start: -90d, predicate: (r) => r._measurement == \"wifi_scan\")",
        "definition": "location tag values",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "ssid",
        "label": "SSID",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "eduroam-influx"
        },
        "hide": 0,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"eduroam\", tag: \"ssid\", start: -90d, predicate: (r) => r._measurement == \"wifi_scan\")",
        "definition": "ssid tag values",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Summary (latest scan at the selected location)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Networks (BSSIDs) heard",
      "datasource": {
        "type": "influxdb",
        "uid": "eduroam-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "eduroam-influx"
          },
          "query": "from(bucket: \"eduroam\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wifi_scan\" and exists r.bssid)\n  |> filter(fn: (r) => r.location =~ /^${location:regex}$/)\n  |> filter(fn: (r) => contains(value: r._field, set: [\"signal_dbm\", \"channel_util_pct\", \"station_count\", \"wifi_gen\"]))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"bssid\"])\n  |> sort(columns: [\"_time\"])\n  |> last(column: \"_time\")\n  |> group()\n  |> count(column: \"signal_dbm\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
