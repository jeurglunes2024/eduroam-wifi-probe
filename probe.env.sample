# Sample probe configuration. Copy to /etc/eduroam-probe/probe.env on the Pi
# and fill in your site's values. NEVER commit the real probe.env.
PROBE_ID=eduprobe-01
TEST_IFACE=wlan0
SSID=eduroam

# --- 802.1X / eduroam ---
EAP_METHOD=PEAP                         # or TTLS
EAP_PHASE2=auth=MSCHAPV2                # TTLS often uses auth=PAP
EAP_IDENTITY=you@your-institution.edu
# EAP_ANON_IDENTITY=anonymous@your-institution.edu   # optional
EAP_DOMAIN_MATCH=radius.your-institution.edu          # RADIUS server cert name

# Password handling: leave both unset and `run` prompts for it (kept in memory
# only). For unattended runs, store the NT hash from `eduroam-probe hash-password`:
# EAP_PASSWORD_HASH=<64 hex chars>

# If your institution publishes no CA, pin the server cert instead.
# Get the hash from a run's log, then update it when the cert is renewed:
# EAP_SERVER_CERT_HASH=<64 hex chars>
# EAP_CA_CERT=/etc/eduroam-probe/radius-ca.pem        # alternative if a CA is provided

# --- Security scan ---
# Your institution's real AP vendor MAC prefixes, comma-separated. Enables the
# unknown_vendor rogue-AP check. Leave unset to skip it.
# KNOWN_OUIS=aa:bb:cc,dd:ee:ff

# --- Where the probe sits / what it tests ---
LOCATION=unspecified
DNS_TEST_HOST=www.google.com
HTTP_TEST_URL=https://www.google.com/generate_204
PING_TARGET=8.8.8.8
# IPERF_SERVER=iperf.your-institution.edu             # optional throughput tests
